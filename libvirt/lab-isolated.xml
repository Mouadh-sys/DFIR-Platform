<network>
  <name>lab-isolated</name>
  <bridge name="virbr-lab" stp="on" delay="0"/>
  <!-- Pure isolated network: No <forward> block guarantees zero NAT and no routing to host uplinks -->
  <ip address="10.10.10.1" netmask="255.255.255.0">
    <dhcp>
      <range start="10.10.10.100" end="10.10.10.200"/>
      <host mac="52:54:00:10:10:20" name="WS-FIN-01" ip="10.10.10.20"/>
      <host mac="52:54:00:10:10:30" name="SRV-WEB-01" ip="10.10.10.30"/>
    </dhcp>
  </ip>
</network>
